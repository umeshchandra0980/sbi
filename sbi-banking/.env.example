# ============================================================
# SBI Banking Portal - Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- App ---
APP_ENV=development
APP_NAME="SBI Online Banking"
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
POSTGRES_USER=sbi_user
POSTGRES_PASSWORD=sbi_secure_pass_change_me
POSTGRES_DB=sbi_banking
DATABASE_URL=postgresql://sbi_user:sbi_secure_pass_change_me@localhost:5432/sbi_banking

# --- Redis ---
REDIS_PASSWORD=redis_secure_pass_change_me
REDIS_URL=redis://:redis_secure_pass_change_me@localhost:6379/0

# --- JWT ---
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP ---
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@SBI123
ADMIN_EMAIL=admin@sbi.co.in

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="SBI Online Banking"
