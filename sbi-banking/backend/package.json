{
  "name": "sbi-banking-backend",
  "version": "1.0.0",
  "description": "SBI Online Banking - REST API",
  "main": "src/server.js",
  "scripts": {
    "start":   "node src/server.js",
    "dev":     "nodemon src/server.js",
    "db:setup":"psql -U postgres -c \"CREATE DATABASE sbi_banking;\" && psql -U postgres -d sbi_banking -f src/config/schema.sql && psql -U postgres -d sbi_banking -f src/config/seed.sql"
  },
  "dependencies": {
    "bcryptjs":          "^2.4.3",
    "cors":              "^2.8.5",
    "dotenv":            "^16.3.1",
    "express":           "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken":      "^9.0.2",
    "pg":                "^8.11.3",
    "uuid":              "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
